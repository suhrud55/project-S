pipeline {
    agent any

    environment {
        GIT_REPO_NAME = "project-S"
        GIT_USER_NAME = "suhrud55"
        AWS_ACCOUNT_ID = "539247488278"
        AWS_REGION = "ap-south-1"
        BACKEND_ECR_REPO = "backend"
        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/"
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/suhrud55/project-S.git'
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                dir('backend') {
                    sh 'docker system prune -f'
                    sh 'docker container prune -f'
                    sh 'docker build -t backend .'
                }
            }
        }

        stage('Push Backend Image to ECR') {
            steps {
                script {
                    sh """
                        # Login to AWS ECR
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                        # Ensure ECR repository exists
                        aws ecr describe-repositories --repository-names ${BACKEND_ECR_REPO} || aws ecr create-repository --repository-name ${BACKEND_ECR_REPO}

                        # Tag and push the backend image
                        docker tag backend:latest ${REPOSITORY_URI}${BACKEND_ECR_REPO}:${BUILD_NUMBER}
                        docker push ${REPOSITORY_URI}${BACKEND_ECR_REPO}:${BUILD_NUMBER}
                    """
                }
            }
        }

        stage('Update Backend Deployment YAML') {
            steps {
                dir('kubernetes-files') {
                    withCredentials([string(credentialsId: 'my-git-pattoken', variable: 'git_token')]) {
                        sh """
                            git config user.email "suhrudvalaparla55@gmail.com"
                            git config user.name "suhrud"

                            # Replace the backend image with the new BUILD_NUMBER
                            sed -i "s#image:.*#image: ${REPOSITORY_URI}${BACKEND_ECR_REPO}:${BUILD_NUMBER}#g" backend-deployment.yml

                            # Commit and push the updated YAML
                            git add backend-deployment.yml
                            git commit -m "Update backend image to version ${BUILD_NUMBER}"
                            git push https://${git_token}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                        """
                    }
                }
            }
        }
    }
}
