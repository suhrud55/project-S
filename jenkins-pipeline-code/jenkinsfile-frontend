pipeline {
    agent any

    environment {
        GIT_REPO_NAME = "project-S"
        GIT_USER_NAME = "suhrud55"
        AWS_ACCOUNT_ID = "539247488278"
        AWS_REGION = "ap-south-1"
        FRONTEND_ECR_REPO = "frontend"
        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/"
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/suhrud55/project-S.git'
            }
        }

        stage('Build Frontend Docker Image') {
            steps {
                dir('client') {
                    sh 'docker system prune -f'
                    sh 'docker container prune -f'
                    sh 'docker build -t frontend .'
                }
            }
        }

        stage('Push Frontend Image to ECR') {
            steps {
                script {
                    sh """
                        # Login to ECR
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                        # Ensure ECR repo exists
                        aws ecr describe-repositories --repository-names ${FRONTEND_ECR_REPO} || aws ecr create-repository --repository-name ${FRONTEND_ECR_REPO}

                        # Tag and push
                        docker tag frontend:latest ${REPOSITORY_URI}${FRONTEND_ECR_REPO}:${BUILD_NUMBER}
                        docker push ${REPOSITORY_URI}${FRONTEND_ECR_REPO}:${BUILD_NUMBER}
                    """
                }
            }
        }

        stage('Update Frontend Deployment YAML') {
            steps {
                dir('kubernetes-files') {
                    withCredentials([string(credentialsId: 'my-git-pattoken', variable: 'git_token')]) {
                        sh """
                            git config user.email "suhrudvalaparla55@gmail.com"
                            git config user.name "suhrud"

                            # Replace image in Deployment YAML with the new tag
                            sed -i "s#image:.*#image: ${REPOSITORY_URI}${FRONTEND_ECR_REPO}:${BUILD_NUMBER}#g" frontend-deploy-service.yml

                            # Commit & push
                            git add frontend-deploy-service.yml
                            git commit -m "Update frontend image to version ${BUILD_NUMBER}"
                            git push https://${git_token}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                        """
                    }
                }
            }
        }
    }
}
